          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este chat sale de tu teléfono, pero tu Mac lo guarda: está en Cerebro › Memoria › Chats de %1$@. %2$@ empieza de cero."
          }
