        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个聊天会从手机上移走，但你的 Mac 会保留它：在 %1$@ 的“大脑 › 记忆 › 聊天”里。%2$@ 将重新开始。"
