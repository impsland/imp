            "value" : "iPhone 解锁之前，Imp 无法打开它的连接。"
          }
        }
      }
    },
    "Imp couldn't keep the keys safely. %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no pudo guardar las claves de forma segura. %@"
