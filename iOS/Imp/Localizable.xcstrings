    "Imp can't open its links until your iPhone has been unlocked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no puede abrir sus vínculos hasta que desbloquees el iPhone."
