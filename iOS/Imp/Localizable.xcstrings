        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 版 Imp"
          }
        }
      }
    },
    "Imps you toss from your Mac live here. Drag them, chat with them, throw them back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imps you toss from your Mac live here. Drag them, chat with them, throw them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Imps que lances desde tu Mac viven aquí. Arrástralos, charla con ellos y devuélvelos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你从 Mac 上扔出的 Imp 会住在这里。拖动它们、和它们聊天，也可以再扔回去。"
          }
        }
      }
    },
