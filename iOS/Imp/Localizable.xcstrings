    "Throw an Imp off the side of your Mac's screen — it lands here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Throw an Imp off the side of your Mac's screen — it lands here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza un Imp por el lado de la pantalla de tu Mac: aterriza aquí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一个 Imp 从 Mac 屏幕的边缘扔出去，它就会落在这里。"
          }
        }
      }
    },
