    "Copy the pairing link on your Mac first, then paste it here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the pairing link on your Mac first, then paste it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero copia el enlace de emparejamiento en tu Mac y pégalo aquí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 Mac 上复制配对链接，然后粘贴到这里。"
          }
        }
      }
    },
    "Imp for iPhone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imp for iPhone"
