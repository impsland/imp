{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Ask %@ to ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ to "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a %@ que "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请 %@ "
          }
        }
      }
    },
    "Ask me anything — I work on your Mac. I can message the Imps on your Mac too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask me anything — I work on your Mac. I can message the Imps on your Mac too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntame lo que quieras: trabajo en tu Mac. También puedo escribir a los Imps de tu Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽管问我，我在你的 Mac 上工作。我也可以给你 Mac 上的其他 Imp 发消息。"
          }
        }
      }
    },
    "Chat": {
      "extractionState": "manual",
