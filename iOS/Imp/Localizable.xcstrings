    "The Imps on this phone stay with your Mac. You can pair again any time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Imps on this phone stay with your Mac. You can pair again any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Imps de este teléfono se quedan con tu Mac. Puedes volver a enlazarlo cuando quieras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机上的 Imp 会留在你的 Mac 上。你可以随时重新配对。"
          }
        }
      }
    },
