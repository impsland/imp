      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp finds your other devices on your network, so the Imps you toss can land here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp busca tus otros dispositivos en tu red para que los Imps que lances puedan aterrizar aquí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 会在你的网络中寻找你的其他设备，让你扔出的 Imp 能落到这里。"
