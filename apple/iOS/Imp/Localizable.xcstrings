    "triggers.help.only_if" : {
      "comment" : "Help of the conditions row.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every condition has to hold at that moment, like the battery being low or the time being late."
          }
