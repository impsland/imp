          }
        }
      }
    },
    "personality.help.name" : {
      "comment" : "Help of the name field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you call this Imp. Say its name and it answers."
