    "triggers.help.list" : {
      "comment" : "Help of the triggers list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trigger wakes the Imp up by itself when something happens, like a time or a low battery."
          }
