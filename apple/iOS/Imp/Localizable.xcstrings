        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no conoce este iPhone. Vuelve a vincular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不再认识这台 iPhone。请重新连接。"
