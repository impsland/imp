    "%@ doesn't know this iPhone any more. Link again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doesn't know this iPhone any more. Link again."
