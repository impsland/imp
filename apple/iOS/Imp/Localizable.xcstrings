    },
    "%@ moves in on %@ for good, and its key goes with it. %@ asks you to look it over first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se muda a %@ para siempre y su llave se va con él. %@ te pide que lo revises antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将永久搬到 %@，它的密钥也会一起带走。%@ 请你先过目。"
          }
        }
      }
    },
