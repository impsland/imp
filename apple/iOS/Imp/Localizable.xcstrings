    },
    "personality.help.persona" : {
      "comment" : "Help of the persona field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell it who to be, like a kind pirate or a quiet helper. It will talk that way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile quién ser, como un pirata amable o un ayudante callado. Hablará así."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉它要做谁，比如和气的海盗或安静的帮手。它就会那样说话。"
          }
        }
      }
    },
