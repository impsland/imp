    "%@ has no room for another Imp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no room for another Imp"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
