{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (now %@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (now %2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (ahora %@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（现为 %@）"
          }
        }
      }
    },
    "%@ asks" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pregunta"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 问道"
          }
        }
      }
    },
    "%@ can control your Mac: it takes screenshots and clicks and types in other apps." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede controlar tu Mac: hace capturas de pantalla, hace clic y escribe en otras apps."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可以控制你的 Mac：它会截屏，并在其他 App 中点击和输入。"
          }
        }
      }
    },
    "%@ can run commands on your Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede ejecutar comandos en tu Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可以在你的 Mac 上运行命令。"
          }
        }
      }
    },
    "%@ comes to the front" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pasa al frente"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 来到最前面"
          }
        }
      }
    },
    "%@ copy" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia de %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ didn't answer in time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió a tiempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有及时回答。"
          }
        }
      }
    },
    "%@ didn't take me." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no me aceptó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有收下我。"
          }
        }
      }
    },
    "%@ didn't wait for an answer, so its Imp didn't move in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no esperó una respuesta, así que su Imp no se mudó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有等到回答，所以它的 Imp 没有搬进来。"
          }
        }
      }
    },
    "%@ doesn't know this Mac any more. Link it again in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no conoce este Mac. Vuelve a vincularlo en Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已不认识这台 Mac。请在“设置”中重新关联。"
          }
        }
      }
    },
    "%@ doesn't know this Mac any more. Link it again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no conoce este Mac. Vuelve a vincularlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已不认识这台 Mac。请重新关联。"
          }
        }
      }
    },
    "%@ flies back to %@. If it is away, %@ goes now and %@ hears when it is back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ flies back to %2$@. If it is away, %3$@ goes now and %4$@ hears when it is back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vuelve volando a %2$@. Si está fuera de alcance, %3$@ se va ya y %4$@ se entera cuando vuelva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会飞回 %2$@。如果它不在线，%3$@ 会马上离开，等 %4$@ 回来后才会得知。"
          }
        }
      }
    },
    "%@ flies off the screen onto %@. Or throw it hard at the side of the screen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ flies off the screen onto %2$@. Or throw it hard at the side of the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sale volando de la pantalla hacia %2$@. O lánzalo con fuerza contra el borde de la pantalla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会飞出屏幕，落到 %2$@ 上。也可以用力把它扔向屏幕边缘。"
          }
        }
      }
    },
    "%@ gets these tools: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ gets these tools: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ recibe estas herramientas: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 获得这些工具：%2$@"
          }
        }
      }
    },
    "%@ goes back into the Imps' window, and its triggers rest." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuelve a la ventana de los Imps y sus disparadores descansan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 回到 Imp 窗口，它的触发器也会暂停。"
          }
        }
      }
    },
    "%@ has no brain yet, so it can't think. Give it one in its settings on %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ aún no tiene cerebro, así que no puede pensar. Dale uno en sus ajustes en %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 还没有大脑，所以无法思考。请在 %2$@ 上的设置里给它一个。"
          }
        }
      }
    },
    "%@ has no brain yet. Open its settings, choose the Brain tab and pick an AI service and a model." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no tiene cerebro. Abre sus ajustes, elige la pestaña Cerebro y escoge un servicio de IA y un modelo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 还没有大脑。打开它的设置，选择“大脑”标签，然后选一个 AI 服务和模型。"
          }
        }
      }
    },
    "%@ has no room for me." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene sitio para mí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有地方容纳我了。"
          }
        }
      }
    },
    "%@ hides until you show it again from the menu bar (Show) or click it in the Imps' window. Its triggers rest meanwhile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se oculta hasta que lo muestres de nuevo desde la barra de menús (Mostrar) o lo pulses en la ventana de los Imps. Mientras tanto, sus disparadores descansan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会藏起来，直到你在菜单栏中点“显示”或在 Imp 窗口中点它。在此期间，它的触发器暂停。"
          }
        }
      }
    },
    "%@ hides until you show it again from the menu bar (Show). It keeps visiting meanwhile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se oculta hasta que lo muestres de nuevo desde la barra de menús (Mostrar). Mientras tanto, sigue de visita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会藏起来，直到你在菜单栏中点“显示”。在此期间，它仍在这里做客。"
          }
        }
      }
    },
    "%@ is already used by %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already used by %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya lo usa %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被 %@ 使用"
          }
        }
      }
    },
    "%@ is asleep" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está dormido"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 睡着了"
          }
        }
      }
    },
    "%@ is asleep. %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ duerme. %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 睡着了。%2$@"
          }
        }
      }
    },
    "%@ is asleep: %@ is away" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is asleep: %2$@ is away"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ duerme: %2$@ está fuera"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 睡着了：%2$@ 不在线"
          }
        }
      }
    },
    "%@ is away, so %@ can't think right now. It wakes up when %@ is back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is away, so %2$@ can't think right now. It wakes up when %3$@ is back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está fuera de alcance, así que %2$@ no puede pensar ahora. Se despierta cuando %3$@ vuelva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不在线，所以 %2$@ 现在无法思考。%3$@ 回来后它就会醒来。"
          }
        }
      }
    },
    "%@ is in front" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está al frente"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 位于最前面"
          }
        }
      }
    },
    "%@ is in the middle of a game." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en plena partida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在玩游戏。"
          }
        }
      }
    },
    "%@ is linked." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está enlazado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已关联。"
          }
        }
      }
    },
    "%@ is off" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está desactivado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已关闭"
          }
        }
      }
    },
    "%@ is open" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está abierto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已打开"
          }
        }
      }
    },
    "%@ is still answering" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún está respondiendo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 仍在回答"
          }
        }
      }
    },
    "%@ is taken by macOS or another app. Pick other keys." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya lo usa macOS u otra app. Elige otras teclas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被 macOS 或其他 App 占用。请选择其他按键。"
          }
        }
      }
    },
    "%@ isn't reachable right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede llegar a %@ ahora mismo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在联系不上 %@。"
          }
        }
      }
    },
    "%@ isn't the device it was when you linked it, so Imp turned it away." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no es el dispositivo que enlazaste, así que Imp lo rechazó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已不是你当初关联的那台设备，所以 Imp 拒绝了它。"
          }
        }
      }
    },
    "%@ isn't there any more." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已经不在了。"
          }
        }
      }
    },
    "%@ keeps a short recap and the last exchange. The whole chat stays to read." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ guarda un resumen corto y el último intercambio. El chat entero sigue para leer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 只保留简短摘要和最后一轮对话。整个聊天仍可阅读。"
          }
        }
      }
    },
    "%@ on %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ on %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 在 %2$@"
          }
        }
      }
    },
    "%@ only" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅 %@"
          }
        }
      }
    },
    "%@ plays it with its own character: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ plays it with its own character: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lo reproduce con su propio carácter: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会以自己的性格来播放：%2$@。"
          }
        }
      }
    },
    "%@ remembers this recap instead of the messages above it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recuerda este resumen en lugar de los mensajes de arriba."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 记住这段摘要，而不是上面的消息。"
          }
        }
      }
    },
    "%@ s" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 秒"
          }
        }
      }
    },
    "%@ went away before its Imp could move in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se fue antes de que su Imp pudiera mudarse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在它的 Imp 搬进来之前就离开了。"
          }
        }
      }
    },
    "%@ wouldn't link: its code ran out or was replaced. Show a fresh one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no quiso enlazarse: su código caducó o fue reemplazado. Muestra uno nuevo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有关联：它的二维码已过期或被替换。请显示一个新的。"
          }
        }
      }
    },
    "%@'s animations" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animaciones de %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的动画"
          }
        }
      }
    },
    "%@'s side of the talk and its memory of it are gone for good. %@ keeps its own." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@'s side of the talk and its memory of it are gone for good. %2$@ keeps its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La parte de %1$@ en la charla y su recuerdo de ella se pierden para siempre. %2$@ conserva la suya."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 这一边的对话及其记忆将永久消失。%2$@ 会保留自己的那一份。"
          }
        }
      }
    },
    "%@, visiting from %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, visiting from %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, de visita desde %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，来自 %2$@ 的访客"
          }
        }
      }
    },
    "%lld" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        },
        "zh-Hans" : {
