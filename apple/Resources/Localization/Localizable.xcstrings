        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉它怎么回答的隐藏规则。大多数人从不修改。"
          }
        }
      }
    },
    "personality.help.voice" : {
      "comment" : "Help of the voice section.",
      "extractionState" : "manual",
      "localizations" : {
