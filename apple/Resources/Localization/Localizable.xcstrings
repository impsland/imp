    "For a device that can't scan: paste the link in Scan Code… on the other device. Keep it private: it lets a device link with this Mac for a while." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un dispositivo que no puede escanear: pega el enlace en Escanear código… en el otro dispositivo. Mantenlo en privado: permite que un dispositivo se vincule con este Mac durante un rato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于无法扫描的设备：在另一台设备的“扫描代码…”中粘贴此链接。请勿外传：它能让一台设备在一段时间内与这台 Mac 连接。"
          }
        }
      }
