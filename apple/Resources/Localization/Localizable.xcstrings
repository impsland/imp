    "moves.help.builtin" : {
      "comment" : "Help of the built-in moves row.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one of the moves every Imp has and make a version only for this Imp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige uno de los movimientos que tienen todos los Imps y haz una versión solo para este."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选一个所有 Imp 都有的动作，为这个 Imp 做一个专属版本。"
          }
        }
      }
    },
    "moves.help.follow" : {
      "comment" : "Help of the follow section.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what this Imp does when you move your mouse pointer: stay still, look at it, or run after it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué hace este Imp cuando mueves el puntero del ratón: quedarse quieto, mirarlo o correr tras él."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你移动鼠标指针时这个 Imp 做什么：不动、看着它，或跟着它跑。"
          }
        }
      }
    },
    "moves.help.follow_how" : {
      "comment" : "Help of the follow mode picker.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: it stays still. Eyes: only its eyes look at the pointer. Hop: it jumps after the pointer. Glide: it slides after the pointer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: se queda quieto. Ojos: solo sus ojos miran el puntero. Saltito: salta tras el puntero. Deslizarse: se desliza tras el puntero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关：它不动。眼睛：只有眼睛看着指针。蹦跳：它跳着追指针。滑行：它滑着追指针。"
          }
        }
      }
    },
    "moves.help.own" : {
      "comment" : "Help of the own animations list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves made for only this Imp. They play instead of the shared ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movimientos hechos solo para este Imp. Se usan en lugar de los compartidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只为这个 Imp 做的动作。它们会代替共用的动作。"
          }
        }
      }
    },
    "moves.help.speed" : {
      "comment" : "Help of the follow speed slider.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How fast it goes after the pointer. Only for Hop and Glide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué tan rápido va tras el puntero. Solo para Saltito y Deslizarse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它追指针有多快。只对蹦跳和滑行有用。"
          }
        }
      }
    },
