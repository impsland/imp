    "Imp %lld (“%@”)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Imp %1$lld (“%2$@”)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp %lld (“%@”)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp %lld（“%@”）"
          }
        }
      }
    },
    "Imp can't listen for your other devices on this network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no puede recibir conexiones de tus otros dispositivos en esta red."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法在此网络上监听你的其他设备。"
          }
        }
      }
    },
    "Imp can't read its list of linked devices." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no puede leer su lista de dispositivos enlazados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法读取已关联设备的列表。"
          }
        }
      }
    },
    "Imp can't read that file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no puede leer ese archivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法读取那个文件。"
          }
        }
      }
    },
    "Imp can't save its list of linked devices." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no puede guardar su lista de dispositivos enlazados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法保存已关联设备的列表。"
          }
        }
      }
    },
    "Imp couldn't keep the account's key safe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no pudo guardar la clave de la cuenta de forma segura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法安全保存账户的密钥。"
          }
        }
      }
    },
    "Imp couldn't reach that device. Is it open, on the same network or the same server?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no pudo llegar a ese dispositivo. ¿Está abierto, en la misma red o con el mismo servidor?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法连接到那台设备。它是否已打开，并处在同一网络或同一服务器上？"
          }
        }
      }
    },
    "Imp has reached its limit of linked devices." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp ha llegado a su límite de dispositivos enlazados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 已达到可关联设备的上限。"
          }
        }
      }
    },
    "Imp may not use the camera." : {
