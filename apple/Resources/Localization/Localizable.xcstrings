    "How audio shows in a bubble. Chats always have players." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se muestra el audio en una burbuja. Los chats siempre tienen reproductores."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频在气泡中的显示方式。对话中总是显示播放器。"
          }
        }
      }
    },
    "How it feels during this beat. Keep: whatever it feels anyway." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se siente durante este paso. Mantener: lo que sienta de todos modos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此节拍中它的感受。保持：它本来的感受。"
          }
        }
      }
    },
    "How long an Imp waits for a model, and how it retries." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto espera un Imp a un modelo y cómo reintenta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 等待模型的时长以及重试方式。"
          }
        }
      }
    },
    "How long it plays (%@ plays it at its own pace)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto dura (%@ la reproduce a su propio ritmo)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放时长（%@ 按自己的节奏播放）"
          }
        }
      }
    },
    "How many recent exchanges go with each message. Fewer is faster and cheaper." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos intercambios recientes van con cada mensaje. Menos es más rápido y barato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条消息附带多少轮最近的对话。越少越快越省。"
          }
        }
      }
    },
    "How many times it goes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas veces lo hace"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做几次"
          }
        }
      }
    },
    "How tall the text box grows before it scrolls." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto crece el cuadro de texto antes de desplazarse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本框在滚动前能长多高。"
          }
        }
      }
    },
    "I can't hear you. Turn on the microphone for Imp in System Settings › Privacy & Security › Microphone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te oigo. Activa el micrófono para Imp en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我听不到你。请在“系统设置” › “隐私与安全性” › “麦克风”中为 Imp 打开麦克风。"
          }
        }
      }
    },
    "I didn't catch that. Type it?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te entendí. ¿Lo escribes?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我没听清。要打字吗？"
          }
        }
      }
    },
    "I don't know a trigger called “%@”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No conozco ningún disparador llamado “%@”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我不知道名为“%@”的触发器。"
          }
        }
      }
    },
    "I heard nothing. Not even a whisper." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No oí nada. Ni un susurro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什么也没听到，连一声耳语都没有。"
          }
        }
      }
    },
    "I was hidden, so I couldn't go. Send me again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaba oculto, así que no pude irme. Envíame de nuevo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我被隐藏了，所以没能出发。请再送我一次。"
          }
        }
      }
    },
    "I wasn't allowed to read the %@ key from your Keychain. Ask again and choose Allow, or paste the key in All Imps › Services." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No me dejaron leer la clave de %@ de tu llavero. Vuelve a pedirlo y elige Permitir, o pega la clave en Todos los Imps › Servicios."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我无权从你的钥匙串读取 %@ 密钥。请重试并选择“允许”，或在“所有 Imp › 服务”中粘贴密钥。"
          }
        }
      }
    },
    "Icon" : {
      "localizations" : {
