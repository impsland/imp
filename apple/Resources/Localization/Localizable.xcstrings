    "personality.help.about" : {
      "comment" : "Help of the field about what the Imp is good at.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One or two lines. The other Imps read it to know whom to ask for what."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una o dos líneas. Los otros Imps la leen para saber a quién pedirle cada cosa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一两行字。其他 Imp 会读它，来决定什么事该问谁。"
          }
        }
      }
    },
    "personality.help.name" : {
      "comment" : "Help of the name field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you call this Imp. Say its name and it answers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo llamas a este Imp. Di su nombre y responde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你怎么称呼这个 Imp。叫它的名字，它就会回答。"
          }
        }
      }
    },
    "personality.help.persona" : {
      "comment" : "Help of the persona field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell it who to be, like a kind pirate or a quiet helper. It will talk that way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile quién ser, como un pirata amable o un ayudante callado. Hablará así."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉它要做谁，比如和气的海盗或安静的帮手。它就会那样说话。"
          }
        }
      }
    },
    "personality.help.rules" : {
      "comment" : "Help of the reply rules switch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hidden rules that tell it how to answer. Most people never change them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas ocultas que le dicen cómo responder. Casi nadie las cambia."
