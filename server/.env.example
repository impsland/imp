# Copy to .env and fill in. Generate the secret with: openssl rand -base64 48
DEN_SECRET=
# The host name people reach the Den on. Caddy gets its TLS certificate for it.
DEN_HOST=den.example.org
DEN_PUBLIC_URL=https://den.example.org
# Optional: another image or tag (default ghcr.io/impsland/imp:latest).
# IMP_IMAGE=ghcr.io/impsland/imp:1.1
