msgstr "Quitar cabecera"

#. Button and dialog title: remove a tool server from an Imp.
msgctxt "tools.remove_server"
msgid "Remove server"
msgstr "Quitar servidor"

#. Message of the dialog that removes a tool server.
msgctxt "tools.remove_server.message"
msgid "The Imp loses the tools of this server."
msgstr "El Imp pierde las herramientas de este servidor."

#. Label of a tool server's name field.
msgctxt "tools.server_name"
msgid "Name"
msgstr "Nombre"

#. In the extra tool editor: its setup is shared, while each Imp switches it on or off for itself.
msgctxt "tools.shared_setup"
msgid "Every Imp that uses this tool gets this setup. Each Imp switches it on or off for itself."
msgstr "Todos los Imps que usan esta herramienta reciben esta configuración. Cada Imp la activa o desactiva por su cuenta."

#. Panel title.
msgctxt "tools.title"
msgid "Tools"
msgstr "Herramientas"

#. Button that adds a trigger.
msgctxt "triggers.add"
msgid "Add"
msgstr "Añadir"

#. Action on a trigger.
msgctxt "triggers.delete"
msgid "Delete trigger"
msgstr "Eliminar disparador"

#. Destructive action on a shared trigger: delete it for every Imp.
msgctxt "triggers.delete_every"
msgid "Delete for every Imp"
msgstr "Borrar para todos"

#. Confirmation before deleting a shared trigger for every Imp.
msgctxt "triggers.delete_every.title"
msgid "Delete “{name}” for every Imp?"
msgstr "¿Borrar “{name}” para todos?"

#. Action on a trigger.
msgctxt "triggers.edit"
msgid "Edit trigger"
msgstr "Editar disparador"

#. Empty state of the triggers list.
msgctxt "triggers.empty"
msgid "No triggers yet. Add one and {name} acts on its own."
msgstr "Aún no hay disparadores. Añade uno y {name} actuará por su cuenta."

#. Help of the trigger action.
msgctxt "triggers.help.do"
msgid "What the Imp does when it goes off."
msgstr "Lo que hace el Imp cuando se activa."

#. Help for the For choice in the trigger editor.
msgctxt "triggers.help.for"
msgid "Which Imp does the job. A change here is for this Imp alone unless you pick Every Imp."
msgstr "Qué Imp hace el trabajo. Un cambio aquí es solo para este Imp, salvo que elijas Todos los Imps."

#. Help of the trigger input.
msgctxt "triggers.help.input"
msgid "What the Imp gets to look at when it goes off, like the clipboard."
msgstr "Lo que el Imp puede mirar cuando se activa, como el portapapeles."

#. Help of the instruction field.
msgctxt "triggers.help.instruction"
msgid "Tell the Imp in your own words what to do."
msgstr "Dile al Imp con tus palabras qué hacer."

#. Help of the triggers list.
msgctxt "triggers.help.list"
msgid "A trigger wakes the Imp up by itself when something happens, like a time or a low battery."
msgstr "Un disparador despierta al Imp solo cuando pasa algo, como una hora o poca batería."

#. Help of the trigger name.
msgctxt "triggers.help.name"
msgid "A name so you can find it again."
msgstr "Un nombre para encontrarlo después."

#. Help for the starter kit button.
msgctxt "triggers.help.starter"
msgid "The triggers Imp comes with: clicks, falling asleep and waking up. You see them before anything is added."
msgstr "Los disparadores que trae Imp: clics, dormirse y despertar. Los ves antes de añadir nada."

#. Help of the trigger conditions.
msgctxt "triggers.help.when"
msgid "What has to happen to set it off, like a time, an app or a low battery."
msgstr "Lo que tiene que pasar para activarlo, como una hora, una app o poca batería."

#. Field: the instruction.
msgctxt "triggers.instruction"
msgid "Task"
msgstr "Tarea"

#. Menu item on a shared trigger: make this Imp's own version. The other Imps keep the shared one.
msgctxt "triggers.just_for"
msgid "Just for {name}"
msgstr "Solo para {name}"

#. Title of the sheet that adds a trigger.
msgctxt "triggers.new"
msgid "New"
msgstr "Nuevo"

#. Choice in the trigger editor: the change is for this Imp only.
msgctxt "triggers.scope.just"
msgid "Just {name}"
msgstr "Solo {name}"

#. Below the For choice when the change goes to every Imp.
msgctxt "triggers.scope.note_every"
msgid "Changes it for every Imp."
msgstr "Lo cambia para todos los Imps."

#. Below the For choice when a shared trigger is saved for one Imp.
msgctxt "triggers.scope.note_version"
msgid "Saves a version for {name} only. The other Imps keep the shared one."
msgstr "Guarda una versión solo para {name}. Los demás Imps conservan la compartida."

#. One trigger as a sentence. The event and the action are short phrases.
msgctxt "triggers.sentence"
msgid "When {event}, {action}."
msgstr "Cuando {event}, {action}."

#. Menu item on this Imp's trigger: share it with every Imp.
msgctxt "triggers.share_every"
msgid "Share to all"
msgstr "Para todos"

#. Button in the empty triggers list: review and add the starter kit.
msgctxt "triggers.starter"
msgid "Starter kit"
msgstr "Kit inicial"

#. Screen reader name of a trigger switch.
msgctxt "triggers.switch"
msgid "Trigger: {sentence}"
msgstr "Disparador: {sentence}"

#. Panel title.
msgctxt "triggers.title"
msgid "Triggers"
msgstr "Disparadores"

#. Button that removes this Imp's version of a shared trigger, so the shared one applies again.
msgctxt "triggers.use_shared"
msgid "Use shared"
msgstr "Usar común"

#. Under the confirmation: the Imp's own version is removed.
msgctxt "triggers.use_shared.message"
msgid "The version only {name} has goes."
msgstr "Se quita la versión de {name}."

#. Confirmation before removing this Imp's version of a shared trigger.
msgctxt "triggers.use_shared.title"
msgid "Use the shared “{name}” again?"
msgstr "¿Volver a usar “{name}” compartido?"

#. Switch on the iPhone: voices in new replies.
msgctxt "voice.autoplay"
msgid "Autoplay"
msgstr "Autoplay"

#. Note under the switch.
msgctxt "voice.autoplay_note"
msgid "A voice an Imp marks to play starts by itself in a new reply. Otherwise you tap it."
msgstr "Una voz que un Imp marca para sonar empieza sola en una respuesta nueva. Si no, la tocas."

#. Switch.
msgctxt "voice.listen"
msgid "Listen"
msgstr "Escuchar"

#. Switch.
msgctxt "voice.speak"
msgid "Speak"
msgstr "Hablar"

#. Group title.
msgctxt "voice.title"
msgid "Voice"
msgstr "Voz"

