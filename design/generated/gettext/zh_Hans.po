msgstr "动画"

#. Card title: double click, login, language.
msgctxt "app.behaviour"
msgid "Behaviour"
msgstr "行为"

#. Row.
msgctxt "app.language"
msgid "Language"
msgstr "语言"

#. Switch (desktop).
msgctxt "app.login"
msgid "Start at login"
msgstr "登录时启动"

#. Note under the switch.
msgctxt "app.login_note"
msgid "Open Imp when you sign in."
msgstr "登录时自动打开 Imp。"

#. Card title: appearance, background, embers.
msgctxt "app.look"
msgid "Look"
msgstr "外观"

#. Button.
msgctxt "app.reset"
msgid "Reset Imp"
msgstr "重置 Imp"

#. Group title.
msgctxt "app.title"
msgid "App"
msgstr "App"

#. Help for the Window card.
msgctxt "app.window.info"
msgid "The smallest the window can be made. Everything in it fits any size above this."
msgstr "窗口可以缩到的最小尺寸。窗口里的内容会适应比它更大的任何尺寸。"

#. Row: the smallest height of the app's window.
msgctxt "app.window.min_height"
msgid "Smallest height"
msgstr "最小高度"

#. Row: the smallest width of the app's window.
msgctxt "app.window.min_width"
msgid "Smallest width"
msgstr "最小宽度"

#. A size in points beside a slider, like 660 pt.
msgctxt "app.window.points"
msgid "{value} pt"
msgstr "{value} pt"

#. Card on the App page: the smallest size of the app's window.
msgctxt "app.window.title"
msgid "Window"
msgstr "窗口"

#. Opens the colour chooser.
msgctxt "background.choose_colour"
msgid "Choose a colour…"
msgstr "选择颜色…"

#. Opens a file chooser for a picture or a tile.
msgctxt "background.choose_picture"
msgid "Choose a picture…"
msgstr "选择图片…"

#. Background choice: one colour.
msgctxt "background.colour"
msgid "Colour"
msgstr "颜色"

#. Background choice: one picture that fills the window.
msgctxt "background.picture"
msgid "Picture"
msgstr "图片"

#. Error when the chosen file is not a usable picture.
msgctxt "background.picture_failed"
msgid "That picture could not be used. Pick another one."
msgstr "无法使用这张图片。请换一张。"

#. Background choice: the wall of the dungeon, the default.
msgctxt "background.theme"
msgid "Theme"
msgstr "主题"

#. Background choice: a seamless pattern that repeats.
msgctxt "background.tile"
msgid "Tile"
msgstr "平铺"

#. Hint under the Tile choice.
msgctxt "background.tile_hint"
msgid "A tile repeats to fill the window. Pick a seamless pattern."
msgstr "平铺会重复铺满窗口。请选择可无缝衔接的图案。"

#. Button that adds a Brain service.
msgctxt "brain.add_service"
msgid "Add a service"
msgstr "添加服务"

#. Result of a successful Brain check.
msgctxt "brain.check_ok"
msgid "{name} is awake."
msgstr "{name} 醒了。"

#. Shown while a Brain is checked.
msgctxt "brain.checking"
msgid "Checking…"
msgstr "正在检查…"

#. Primary button of a sleeping Imp's Brain panel when services exist but none is chosen.
msgctxt "brain.choose"
msgid "Choose a service"
msgstr "选择服务"

#. Help of the list button inside the model field: pick from the service's models.
msgctxt "brain.choose_model"
msgid "Pick from the service's models"
msgstr "从服务的模型中选择"

#. Tooltip of the add service button.
msgctxt "brain.help.add_service"
msgid "Add a service"
msgstr "添加服务"

#. Help of the key field.
msgctxt "brain.help.key"
msgid "A secret password that lets the Imp use this service. It stays on this Mac."
msgstr "一个秘密口令，让小鬼可以使用这项服务。它只保存在这台 Mac 上。"

#. Help of the model picker.
msgctxt "brain.help.model"
msgid "The exact brain of the service. Bigger ones think better but are slower."
msgstr "服务里具体的大脑。大的想得更好，但更慢。"

#. Help of the service list.
msgctxt "brain.help.service"
msgid "Pick who does the thinking for this Imp."
msgstr "选择由谁来替这个小鬼思考。"

#. Help of the Brain source switch.
msgctxt "brain.help.source"
msgid "Use the Brain every Imp shares, or pick a different one just for this Imp."
msgstr "使用所有小鬼共用的大脑，或只为这个小鬼选另一个。"

#. Hint at the top of the Brain panel.
msgctxt "brain.hint"
msgid "A Brain is a service and a model. {name} thinks with it."
msgstr "大脑由一项服务和一个模型组成。{name} 用它来思考。"

#. Section: the secret key.
msgctxt "brain.key"
msgid "Key"
msgstr "密钥"

#. Section: the model.
msgctxt "brain.model"
msgid "Model"
msgstr "模型"

#. Placeholder of the model field: the exact name of a model.
msgctxt "brain.model_placeholder"
msgid "Model name"
msgstr "模型名称"

#. Status in the Brain panel.
msgctxt "brain.none"
msgid "No Brain yet"
msgstr "还没有大脑"

#. Field label.
msgctxt "brain.service"
msgid "Service"
msgstr "服务"

#. Row: whose Brain the Imp uses.
msgctxt "brain.source"
msgid "Brain from"
msgstr "大脑来自"

#. Panel title.
msgctxt "brain.title"
msgid "Brain"
msgstr "大脑"

#. A service with no name yet.
msgctxt "brain.unnamed"
msgid "Unnamed"
msgstr "未命名"

#. Choice: use the app's default Brain.
msgctxt "brain.use_app"
msgid "Same as the other Imps"
msgstr "与其他 Imp 相同"

#. Choice: this Imp has its own service and model.
msgctxt "brain.use_own"
msgid "Its own Brain"
msgstr "专属大脑"

#. Screen reader description of the sleeping animation.
msgctxt "brain.zzz"
msgid "Zzz, {name} is asleep"
msgstr "Zzz，{name} 睡着了"

#. Button.
msgctxt "brains.add"
msgid "Add a Brain"
msgstr "添加大脑"

#. Label of the default Brain.
msgctxt "brains.default"
msgid "Default for new Imps"
msgstr "新 Imp 的默认大脑"

#. Empty state of the Brains list.
msgctxt "brains.empty"
msgid "No Brains yet. Add a model on this computer or a service with your key."
msgstr "还没有大脑。可以添加这台电脑上的模型，或使用你自己密钥的服务。"

#. Choice when adding a Brain.
msgctxt "brains.local"
msgid "A model on this computer"
msgstr "这台电脑上的模型"

#. Under a Brain: how many Imps use it.
msgctxt "brains.used_by"
msgid "Used by {count} Imp"
msgid_plural "Used by {count} Imps"
msgstr[0] "{count} 个 Imp 在使用"

#. Choice when adding a Brain.
msgctxt "brains.with_key"
msgid "A service with your key"
msgstr "使用你密钥的服务"

#. Button that adds an item.
msgctxt "common.add"
msgid "Add"
msgstr "添加"

#. Button that goes one step back.
msgctxt "common.back"
msgid "Back"
msgstr "返回"

#. Button that closes a dialog without doing anything.
msgctxt "common.cancel"
msgid "Cancel"
msgstr "取消"

#. Button that tests a setting, such as a Brain or a server.
msgctxt "common.check"
msgid "Check"
msgstr "检查"

#. Button that opens a chooser.
msgctxt "common.choose"
msgid "Choose…"
msgstr "选择…"

#. Button or label that closes a window or panel.
msgctxt "common.close"
msgid "Close"
msgstr "关闭"

#. Button that goes to the next step.
msgctxt "common.continue"
msgid "Continue"
msgstr "继续"

#. Button that closes a sheet or panel after changes.
msgctxt "common.done"
msgid "Done"
msgstr "完成"

#. Spoken name of a small help icon that explains the control beside it.
msgctxt "common.help"
msgid "Help"
msgstr "帮助"

#. Shown while something loads.
msgctxt "common.loading"
msgid "Loading…"
msgstr "正在加载…"

#. Label of a name field.
msgctxt "common.name"
msgid "Name"
msgstr "名称"

#. Screen reader value of a settings section that has something to fix.
msgctxt "common.needs_attention"
msgid "Needs attention"
msgstr "需要注意"

#. State of a switch.
msgctxt "common.off"
msgid "Off"
msgstr "关"

#. State of a switch.
msgctxt "common.on"
msgid "On"
msgstr "开"

#. Button that opens something.
msgctxt "common.open"
msgid "Open"
msgstr "打开"

#. Button that removes an item.
msgctxt "common.remove"
msgid "Remove"
msgstr "移除"

#. Button that starts setting something up.
msgctxt "common.set_up"
msgid "Set up"
msgstr "设置"

#. The app-wide settings, in menus and on buttons.
msgctxt "common.settings"
msgid "Settings"
msgstr "设置"

#. Screen reader name of one step of a short flow. The name is the step's own title.
msgctxt "common.step"
msgid "Step {number} of {total}, {name}"
msgstr "第 {number} 步，共 {total} 步，{name}"

#. Button that repeats something that failed.
msgctxt "common.try_again"
msgid "Try again"
msgstr "重试"

#. Button on a bar that undoes what just happened.
msgctxt "common.undo"
msgid "Undo"
msgstr "撤销"

#. Help of the Den kind.
msgctxt "den.help.kind"
msgid "Pick what kind of thing to look for."
msgstr "选择要找哪一类东西。"

#. Help of the Den public note.
msgctxt "den.help.public"
msgid "Anyone can add it. Chats, memory and keys are never included."
msgstr "任何人都可以添加。聊天、记忆和密钥永远不会包含在内。"

#. Help of the Den search.
msgctxt "den.help.search"
msgid "Type a word to find things."
msgstr "输入一个词来查找。"

#. Help of the Den server.
msgctxt "den.help.server"
msgid "Where people share Imps, animations, triggers and tools."
msgstr "大家分享小鬼、动画、触发器和工具的地方。"

#. Help of the Den name.
msgctxt "den.help.slug"
msgid "A short name for the web address. Use small letters and dashes."
msgstr "网址里用的短名字。用小写字母和短横线。"

#. Help of the Den sort.
msgctxt "den.help.sort"
msgid "Show the most loved first, or the newest first."
msgstr "先显示最受欢迎的，或最新的。"

#. Help of the Den summary.
msgctxt "den.help.summary"
msgid "One sentence so people know what it is."
msgstr "用一句话让大家知道这是什么。"

#. Help of the Den tags.
msgctxt "den.help.tags"
msgid "Words that help people find it. Separate them with commas."
msgstr "帮助大家找到它的词。用逗号分开。"

#. Help of Copy Link in Link a device.
msgctxt "devices.copy_link.help"
msgid "For a device that can't scan: paste the link in Scan code on the other device. Keep it private. It lets a device link with this Mac for a while."
msgstr "适用于无法扫描的设备：在另一台设备的“扫描代码”中粘贴链接。请保密。它会在一段时间内允许设备与这台 Mac 关联。"

#. Under a linked device: the Imps that are on it now.
msgctxt "devices.has"
msgid "Has {imps}"
msgstr "上面有 {imps}"

#. In the devices card when nothing is linked yet.
msgctxt "devices.none"
msgid "No devices yet. Link your iPhone or another Mac and your Imps can visit it."
msgstr "还没有设备。关联你的 iPhone 或另一台 Mac，你的 Imp 就能去拜访。"

#. Button and tab: read another device's code with this Mac's camera, or paste its link.
msgctxt "devices.scan"
msgid "Scan code"
msgstr "扫描代码"

#. Button and tab: show this Mac's code for another device to scan.
msgctxt "devices.show"
msgid "Show code"
msgstr "显示代码"

#. The key was refused.
msgctxt "error.brain.key"
msgid "{service} did not accept the key. Check it and try again."
msgstr "{service} 不接受这个密钥。请检查后重试。"

#. The local model server did not answer.
msgctxt "error.brain.local"
msgid "No model answered. Make sure it is running, then try again."
msgstr "没有模型回应。请确认它正在运行，然后重试。"

#. The model does not exist.
msgctxt "error.brain.model"
msgid "{service} does not have the model {model}. Pick another one."
msgstr "{service} 没有模型 {model}。请换一个。"

#. Shown when someone talks to an Imp that sleeps.
msgctxt "error.brain.none"
msgid "{name} has no Brain yet, so it cannot answer."
msgstr "{name} 还没有大脑，所以无法回答。"

#. The device has no network while a Brain is checked.
msgctxt "error.brain.offline"
msgid "No network. Check your connection, then try again."
msgstr "没有网络。请检查连接后再试。"

#. The service was too slow.
msgctxt "error.brain.timeout"
msgid "{service} did not answer in time. Check its address, or try again later."
msgstr "{service} 没有及时回应。请检查它的地址，或稍后再试。"

#. The service did not answer at all.
msgctxt "error.brain.unreachable"
msgid "Cannot reach {service}. Check the address and your connection."
msgstr "无法连接到 {service}。请检查地址和网络连接。"

#. The only error with no detail. Used when nothing more is known.
msgctxt "error.generic"
msgid "Something went wrong. Try again."
msgstr "出了点问题，请重试。"

#. Saving to disk failed.
msgctxt "error.save"
msgid "Could not save that. Check the free space and try again."
msgstr "无法保存。请检查可用空间后重试。"

#. Sharing failed.
msgctxt "error.share"
msgid "Could not share {name}. Try again in a moment."
msgstr "无法共享 {name}。请稍后再试。"

#. A tool server did not start.
msgctxt "error.tool_failed"
msgid "{tool} could not start. Check its settings."
msgstr "{tool} 无法启动。请检查它的设置。"

#. The tooltip of the toolbar button.
msgctxt "extension.action_title"
msgid "Imp"
msgstr "Imp"

#. Count of all the entries.
msgctxt "extension.activity.count_all"
msgid "{total} in all"
msgstr "共 {total} 条"

#. Count of the entries that match the search.
msgctxt "extension.activity.count_some"
msgid "{shown} of {total}"
msgstr "{total} 条中的 {shown} 条"

#. Shown when Imp has done nothing yet.
msgctxt "extension.activity.empty"
msgid "Nothing yet."
msgstr "还没有。"

#. Start of a line: Imp found something on a page. The searched words follow.
msgctxt "extension.activity.found"
msgid "Found"
msgstr "找到了"

#. Help for the list of what Imp just did.
msgctxt "extension.activity.help"
msgid "When Imp reads a page or looks for something on one, it shows up here."
msgstr "Imp 读页面或在页面上找东西时，会显示在这里。"

#. Accessible name of the full list.
msgctxt "extension.activity.list_label"
msgid "Everything Imp did lately"
msgstr "Imp 最近做过的所有事"

#. Start of a line: Imp looked for something on a page and did not find it. The searched words follow.
msgctxt "extension.activity.looked_for"
msgid "Looked for"
msgstr "找过"

#. Shown when the search finds nothing.
msgctxt "extension.activity.no_match"
msgid "Nothing matches that."
msgstr "没有匹配的内容。"

#. A line: Imp read a page.
msgctxt "extension.activity.read"
msgid "Read the page"
msgstr "读了页面"

#. A line: Imp could not read a page.
msgctxt "extension.activity.read_failed"
msgid "Could not read the page"
msgstr "没能读页面"

#. Placeholder of the search box over the full list.
msgctxt "extension.activity.search"
msgid "Search"
msgstr "搜索"

#. Accessible name of the search box over the full list.
msgctxt "extension.activity.search_label"
msgid "Search what Imp did"
msgstr "搜索 Imp 做过的事"

#. Button that opens the whole list. The number is how many entries there are.
msgctxt "extension.activity.see_all"
msgid "See all {count}"
msgstr "查看全部 {count} 条"

#. Title of the list of what Imp just did in the browser.
msgctxt "extension.activity.title"
msgid "Lately"
msgstr "最近"

#. How long ago: a number of hours, as short as possible.
msgctxt "extension.ago.hours"
msgid "{n}h"
msgstr "{n}时"

#. How long ago: a number of minutes, as short as possible.
msgctxt "extension.ago.minutes"
msgid "{n}m"
msgstr "{n}分"

#. How long ago something happened: just now.
msgctxt "extension.ago.now"
msgid "now"
msgstr "刚刚"

#. How long ago: a number of seconds, as short as possible.
msgctxt "extension.ago.seconds"
msgid "{n}s"
msgstr "{n}秒"

#. Button that goes back to the first screen of the popup.
msgctxt "extension.back"
msgid "Back"
msgstr "返回"

#. The extension description in the browser store and extension list.
msgctxt "extension.description"
msgid "Lets Imp know which page you are on and where things are on it. Talks only to Imp on this computer."
msgstr "让 Imp 知道你在看哪个页面，以及页面上的东西在哪里。只和这台电脑上的 Imp 通信。"

#. Label of the small question mark button that opens a help tip.
msgctxt "extension.help"
msgid "What is this?"
msgstr "这是什么？"

#. Accessible name of an Imp that is asleep.
msgctxt "extension.imp.asleep"
msgid "{name} is asleep"
msgstr "{name} 在睡觉"

#. Accessible name of an Imp that is on another device.
msgctxt "extension.imp.away"
msgid "{name} is on {device}"
msgstr "{name} 在 {device} 上"

#. Name of the phone an Imp is on when it did not say which.
msgctxt "extension.imp.device_default"
msgid "your iPhone"
msgstr "你的 iPhone"

#. Accessible name of an Imp that has no name.
msgctxt "extension.imp.fallback"
msgid "Imp"
msgstr "Imp"

#. Accessible name of an Imp that is working.
msgctxt "extension.imp.working"
msgid "{name} is working"
msgstr "{name} 正在工作"

#. Accessible name of an Imp that is working on another device.
msgctxt "extension.imp.working_away"
msgid "{name} is working on {device}"
msgstr "{name} 正在 {device} 上工作"

#. Shown when Imp is not running: what to do.
msgctxt "extension.offline.body"
msgid "Start Imp on this computer and this connects by itself."
msgstr "在这台电脑上启动 Imp，这里会自动连上。"

#. Link to download Imp.
msgctxt "extension.offline.get"
msgid "Get Imp"
msgstr "获取 Imp"

#. Title shown when Imp is not running.
msgctxt "extension.offline.title"
msgid "Imp is asleep."
msgstr "Imp 在睡觉。"

#. Button that opens the Imp app.
msgctxt "extension.open"
msgid "Open Imp"
msgstr "打开 Imp"

#. Help for the button that opens the Imp app.
msgctxt "extension.open.help"
msgid "Opens the Imp app. It starts Imp if it is not running."
msgstr "打开 Imp 应用。如果它没在运行，就先启动它。"

#. Note that nothing leaves the computer.
msgctxt "extension.private"
msgid "Stays on this computer"
msgstr "只留在这台电脑上"

#. Button that tries to reach Imp again.
msgctxt "extension.reconnect"
msgid "Try again"
msgstr "重试"

#. Help for the button that tries to reach Imp again.
msgctxt "extension.reconnect.help"
msgid "Looks for Imp again. Use it after you start Imp."
msgstr "重新寻找 Imp。启动 Imp 之后用它。"

#. Connection status while the extension looks for Imp.
msgctxt "extension.status.checking"
msgid "Checking…"
msgstr "正在检查…"

#. Connection status when Imp is reachable.
msgctxt "extension.status.connected"
msgid "Connected"
msgstr "已连接"

#. Connection status when Imp is reachable, with the name of the browser.
msgctxt "extension.status.connected_browser"
msgid "Connected · {browser}"
msgstr "已连接 · {browser}"

#. Connection status while a connection attempt runs.
msgctxt "extension.status.connecting"
msgid "Connecting…"
msgstr "正在连接…"

#. Connection status when Imp cannot be reached.
msgctxt "extension.status.not_connected"
msgid "Not connected"
msgstr "未连接"

#. Help for the page box when the browser keeps the page private.
msgctxt "extension.tab.blind"
msgid "The browser keeps this page to itself. Imp only knows its address."
msgstr "浏览器不让别人看这个页面。Imp 只知道它的地址。"

#. Accessible name of the box that shows the page you are on.
msgctxt "extension.tab.label"
msgid "The page Imp knows"
msgstr "Imp 知道的页面"

#. Help for the page box when Imp can look inside the page.
msgctxt "extension.tab.sees"
msgid "Imp can read this page and find things on it when it needs to."
msgstr "Imp 需要时可以读这个页面，也能在上面找东西。"

#. Name of a page that has no title.
msgctxt "extension.tab.untitled"
msgid "Untitled page"
msgstr "无标题页面"

#. The bubble of the first Imp when the app opens for the first time.
msgctxt "firstrun.asleep_bubble"
msgid "{name} is asleep. Give it a Brain to wake it up."
msgstr "{name} 睡着了。给它一个大脑，就能叫醒它。"

#. The check worked. The Imp wakes up.
msgctxt "firstrun.check.ok"
msgid "{name} is awake."
msgstr "{name} 醒了。"

#. Shown while the Brain is checked. The Imp stirs.
msgctxt "firstrun.check.running"
msgid "Waking {name} up…"
msgstr "正在叫醒 {name}…"

#. The typed service address is not an http or https address.
msgctxt "firstrun.error.address"
