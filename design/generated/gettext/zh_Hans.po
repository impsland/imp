#. Help of the move description.
msgctxt "anim.help.about"
msgid "One sentence about what it does."
msgstr "用一句话说说它做什么。"

#. Help of the beats track.
msgctxt "anim.help.beats"
msgid "Each chip is one moment of the move. Drag to move it or stretch it."
msgstr "每个小块是动作中的一个瞬间。拖动来移动或拉长它。"

#. Help of the hop setting.
msgctxt "anim.help.hop"
msgid "How high the Imp jumps in this beat."
msgstr "小鬼在这一拍里跳多高。"

#. Help of the move icon.
msgctxt "anim.help.icon"
msgid "The picture shown for this move in lists."
msgstr "这个动作在列表里显示的图案。"

#. Help of the move length.
msgctxt "anim.help.length"
msgid "How long the move lasts."
msgstr "动作持续多久。"

#. Help of the move name.
msgctxt "anim.help.name"
msgid "A name so you can find it again."
msgstr "一个名字，方便以后找到它。"

#. Help of when a move plays.
msgctxt "anim.help.plays"
msgid "When this move happens."
msgstr "这个动作什么时候出现。"

#. Help of the shape setting.
msgctxt "anim.help.shape"
msgid "Squash or stretch the body, like a ball."
msgstr "把身体压扁或拉长，像一个球。"

#. Help of the symbol setting.
msgctxt "anim.help.symbol"
msgid "A small picture that pops up beside the Imp."
msgstr "在小鬼旁边冒出来的小图案。"

#. Help of the tilt setting.
msgctxt "anim.help.tilt"
msgid "How far the Imp leans to the side."
msgstr "小鬼向一侧倾斜多少。"

#. Heading of the five bundled animations.
msgctxt "animations.built_in"
msgid "Built in"
msgstr "内置"

#. Button.
msgctxt "animations.find"
msgid "Find more in The Den"
msgstr "到 Den 找更多"

#. Heading of animations that came from The Den.
msgctxt "animations.from_den"
msgid "From The Den"
msgstr "来自 Den"

#. Shown when The Den is not set up.
msgctxt "animations.needs_den"
msgid "Set up The Den to find more."
msgstr "设置 Den 后可以找到更多。"

#. Button and sheet title: make a new animation of your own.
msgctxt "animations.new"
msgid "New animation"
msgstr "新动画"

#. Button.
msgctxt "animations.restore"
msgid "Restore defaults"
msgstr "恢复默认"

#. Placeholder of the search field on the Animations page.
msgctxt "animations.search"
