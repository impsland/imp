msgctxt "triggers.delete_every.title"
msgid "Delete “{name}” for every Imp?"
msgstr ""

#. Action on a trigger.
msgctxt "triggers.edit"
msgid "Edit trigger"
msgstr ""

#. Empty state of the triggers list.
msgctxt "triggers.empty"
msgid "No triggers yet. Add one and {name} acts on its own."
msgstr ""

#. Help of the trigger action.
msgctxt "triggers.help.do"
msgid "What the Imp does when it goes off."
msgstr ""

#. Help for the For choice in the trigger editor.
msgctxt "triggers.help.for"
msgid "Which Imp does the job. A change here is for this Imp alone unless you pick Every Imp."
msgstr ""

#. Help of the trigger input.
msgctxt "triggers.help.input"
msgid "What the Imp gets to look at when it goes off, like the clipboard."
msgstr ""

#. Help of the instruction field.
msgctxt "triggers.help.instruction"
msgid "Tell the Imp in your own words what to do."
msgstr ""

#. Help of the triggers list.
msgctxt "triggers.help.list"
msgid "A trigger wakes the Imp up by itself when something happens, like a time or a low battery."
msgstr ""

#. Help of the trigger name.
msgctxt "triggers.help.name"
msgid "A name so you can find it again."
msgstr ""

#. Help for the starter kit button.
msgctxt "triggers.help.starter"
msgid "The triggers Imp comes with: clicks, falling asleep and waking up. You see them before anything is added."
msgstr ""

#. Help of the trigger conditions.
msgctxt "triggers.help.when"
msgid "What has to happen to set it off, like a time, an app or a low battery."
msgstr ""

#. Field: the instruction.
msgctxt "triggers.instruction"
msgid "Task"
msgstr ""

#. Menu item on a shared trigger: make this Imp's own version. The other Imps keep the shared one.
msgctxt "triggers.just_for"
msgid "Just for {name}"
msgstr ""

#. Title of the sheet that adds a trigger.
msgctxt "triggers.new"
msgid "New trigger"
msgstr ""

#. Choice in the trigger editor: the change is for this Imp only.
msgctxt "triggers.scope.just"
msgid "Just {name}"
msgstr ""

#. Below the For choice when the change goes to every Imp.
msgctxt "triggers.scope.note_every"
msgid "Changes it for every Imp."
msgstr ""

#. Below the For choice when a shared trigger is saved for one Imp.
msgctxt "triggers.scope.note_version"
msgid "Saves a version for {name} only. The other Imps keep the shared one."
msgstr ""

#. One trigger as a sentence. The event and the action are short phrases.
msgctxt "triggers.sentence"
msgid "When {event}, {action}."
msgstr ""

#. Menu item on this Imp's trigger: share it with every Imp.
msgctxt "triggers.share_every"
msgid "Share with Every Imp"
msgstr ""

#. Button in the empty triggers list: review and add the starter kit.
msgctxt "triggers.starter"
msgid "Add the starter kit"
msgstr ""

#. Screen reader name of a trigger switch.
msgctxt "triggers.switch"
msgid "Trigger: {sentence}"
msgstr ""

#. Panel title.
msgctxt "triggers.title"
msgid "Triggers"
msgstr ""

#. Button that removes this Imp's version of a shared trigger, so the shared one applies again.
msgctxt "triggers.use_shared"
