{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (now %@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (now %2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (ahora %@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（现为 %@）"
          }
        }
      }
    },
    "%@ It's too long for a link." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Es demasiado largo para un enlace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 太长，无法放进链接。"
          }
        }
      }
    },
    "%@ asks" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pregunta"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 问道"
          }
        }
      }
    },
    "%@ can do this" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede hacer esto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 能做到"
          }
        }
      }
    },
    "%@ can run commands" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede ejecutar comandos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可以运行命令"
          }
        }
      }
    },
    "%@ can use it" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede usarlo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可以使用"
          }
        }
      }
    },
    "%@ comes to the front" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pasa al frente"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 来到最前面"
          }
        }
      }
    },
    "%@ copy" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia de %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ didn't answer in time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió a tiempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有及时回答。"
          }
        }
      }
    },
    "%@ flies off the screen onto your iPhone. Or throw it hard at the side of the screen." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sale volando de la pantalla hacia tu iPhone. O lánzalo con fuerza contra el borde de la pantalla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会飞出屏幕，落到你的 iPhone 上。也可以把它用力扔向屏幕边缘。"
          }
        }
      }
    },
    "%@ goes back into the Imps' window, and its triggers rest." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuelve a la ventana de los Imps y sus disparadores descansan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 回到 Imp 窗口，它的触发器也会暂停。"
          }
        }
      }
    },
    "%@ has its own model. Other Imps on %@ use %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has its own model. Other Imps on %2$@ use %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene su propio modelo. Los demás Imps en %@ usan %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有自己的模型。%@ 上的其他 Imp 使用 %@。"
          }
        }
      }
    },
    "%@ hides until you show it again from the menu bar (Show) or click it in the Imps' window. Its triggers rest meanwhile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se esconde hasta que lo muestres de nuevo desde la barra de menús (Mostrar) o lo pulses en la ventana de los Imps. Mientras tanto, sus disparadores descansan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会藏起来，直到你在菜单栏中点“显示”或在 Imp 窗口中点它。在此期间，它的触发器暂停。"
          }
        }
      }
    },
    "%@ is %@'s favourite." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is %2$@'s favourite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es el favorito de %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 最喜欢%1$@。"
          }
        }
      }
    },
    "%@ is already used by %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already used by %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya lo usa %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被 %@ 使用"
          }
        }
      }
    },
    "%@ is connected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está conectado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已连接。"
          }
        }
      }
    },
    "%@ is hiding. Click to bring it back to your desktop." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se está escondiendo. Haz clic para traerlo de vuelta a tu escritorio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 藏起来了。点按让它回到桌面。"
          }
        }
      }
    },
    "%@ is in front" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está al frente"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 位于最前面"
          }
        }
      }
    },
    "%@ is off" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está desactivado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已关闭"
          }
        }
      }
    },
    "%@ is open" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está abierto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已打开"
          }
        }
