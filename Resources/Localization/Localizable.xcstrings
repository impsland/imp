        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紧闭双眼，笑得扭来扭去。"
          }
        }
      }
    },
    "Squint" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrecerrados"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眯眼"
          }
        }
      }
    },
    "Squishes into your hold, blushing, while you keep pressing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplasta en tu mano, sonrojado, mientras sigues pulsando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你一直按着时，它在你手里被挤扁，脸红红的。"
          }
        }
      }
    },
    "Stands tall, chin up, sparkling." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se yergue, con la barbilla alta, reluciente."
          }
