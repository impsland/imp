          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” necesita que rellenes: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”需要你填写：%@"
          }
        }
      }
    },
    "“%@” runs a command on your Mac: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” runs a command on your Mac: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ejecuta un comando en tu Mac: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”会在你的 Mac 上运行命令：%@"
          }
        }
      }
    },
    "“%@” uses the same keys and comes first, so this one won't go off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” usa las mismas teclas y va primero, así que este no se activará."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”使用相同的按键且优先，因此这个不会触发。"
          }
        }
      }
    },
