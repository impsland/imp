    "Thinking" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensativo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思考"
          }
        }
      }
    },
    "Thinks hard, then a light bulb." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piensa mucho y luego se le enciende la bombilla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦思冥想，然后灵光一闪。"
          }
        }
      }
    },
    "Thinks, then a light bulb and a hop." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piensa, luego una bombilla y un salto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想一想，灯泡一亮，跳一下。"
          }
        }
      }
    },
    "This Imp has no service and model to think with yet." : {
      "localizations" : {
        "es" : {
