      }
    },
    "The browser extension isn't connected. Add it in Tools › Browser." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La extensión del navegador no está conectada. Añádela en Herramientas › Navegador."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器扩展未连接。请在“工具 › 浏览器”中添加。"
          }
        }
      }
    },
    "The code holds a secret only your phone and this Mac know. It never goes over the network: they use it to recognise each other and to encrypt everything they say." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código guarda un secreto que solo conocen tu teléfono y este Mac. Nunca viaja por la red: lo usan para reconocerse y para cifrar todo lo que se dicen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个代码包含一个只有你的手机和这台 Mac 知道的密钥。它从不经过网络传输：两者用它来相互识别，并加密彼此之间的所有通信。"
          }
        }
      }
    },
    "The file is too big to send to the phone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo es demasiado grande para enviarlo al teléfono."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件太大，无法发送到手机。"
          }
        }
      }
    },
    "The file isn't on the Mac any more." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo ya no está en el Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个文件已不在 Mac 上。"
          }
        }
      }
    },
    "The heart marks %@'s favourite colour." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El corazón marca el color favorito de %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "爱心标记的是 %@ 最喜欢的颜色。"
          }
        }
      }
    },
    "The kit in that link is damaged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El kit de ese enlace está dañado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该链接中的套件已损坏。"
          }
        }
      }
    },
    "The language of Imp's menus, settings and bubbles. You can also set it in System Settings › General › Language & Region › Applications. Imps answer in whatever language you write to them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma de los menús, ajustes y burbujas de Imp. También puedes cambiarlo en Ajustes del Sistema › General › Idioma y región › Aplicaciones. Los Imps responden en el idioma en que les escribas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 的菜单、设置和气泡所用的语言。也可以在“系统设置 › 通用 › 语言与地区 › 应用程序”中设置。Imp 会用你写给它们的语言回答。"
          }
        }
      }
    },
    "The last Imp can't leave. Hatch another first, or reset in All Imps › App." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último Imp no puede irse. Haz nacer otro primero o restablece en Todos los Imps › App."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后一个 Imp 不能离开。请先孵化另一个，或在“所有 Imp” › “App”中重置。"
          }
        }
      }
    },
    "The last Imp stays" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último Imp se queda"
