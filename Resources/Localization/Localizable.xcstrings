        }
      }
    },
    "An Imp arrives at home, not out on your desktop. Its personality and triggers steer what it does with its tools, commands on your Mac included. Read them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Imp llega a casa, no a tu escritorio. Su personalidad y sus disparadores guían lo que hace con sus herramientas, incluidos comandos en tu Mac. Léelos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 会先到家里，而不是出现在桌面上。它的个性和触发器决定它如何使用工具，包括在你的 Mac 上运行命令。请仔细阅读。"
          }
        }
      }
    },
    "An Imp needs a name of up to %lld characters." : {
      "localizations" : {
