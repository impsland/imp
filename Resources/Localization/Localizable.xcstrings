          }
        }
      }
    },
    "Spin round its own axis" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girar sobre su propio eje"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绕自身旋转"
          }
        }
      }
    },
    "Spins all the way round on the spot, like a dancer." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da una vuelta entera en el sitio, como una bailarina."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像舞者一样原地转一整圈。"
          }
        }
      }
    },
    "Spins its gaze all the way round, sparkling." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la mirada en redondo, chispeante."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眼珠转一整圈，闪闪发光。"
          }
        }
      }
    },
    "Spiral eyes, stars circling." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ojos en espiral, estrellas girando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螺旋眼，星星绕圈转。"
          }
        }
      }
    },
    "Spiral eyes, then shakes itself off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ojos en espiral, luego se sacude."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眼睛转圈圈，然后抖抖身子回过神。"
          }
        }
      }
    },
    "Split in Two" : {
