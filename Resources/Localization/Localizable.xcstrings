    },
    "%@ is still answering" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún está respondiendo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 仍在回答"
          }
        }
      }
    },
    "%@ is taken by macOS or another app. Pick other keys." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya lo usa macOS u otra app. Elige otras teclas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被 macOS 或其他 App 占用。请选择其他按键。"
          }
        }
      }
    },
    "%@ isn't reachable right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede llegar a %@ ahora mismo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在联系不上 %@。"
          }
        }
      }
    },
    "%@ key" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clave de %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 密钥"
          }
        }
      }
    },
    "%@ needs a brain before it can chat. Click to set one up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita un cerebro para chatear. Haz clic para configurarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要大脑才能对话。点按进行设置。"
          }
        }
      }
    },
    "%@ only" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅 %@"
          }
        }
      }
    },
    "%@ only talks" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ solo habla"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 只会聊天"
          }
        }
      }
    },
    "%@ plays it with its own character: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ plays it with its own character: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lo reproduce con su propio carácter: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会以自己的性格来播放：%2$@。"
          }
        }
      }
    },
    "%@ remembers this recap instead of the messages above it (they stay here to read), plus the last message before it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recuerda este resumen en lugar de los mensajes anteriores (siguen aquí para leerlos), además del último mensaje antes de él."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会记住这份摘要而不是上面的消息（它们仍保留在此供阅读），外加摘要之前的最后一条消息。"
          }
        }
      }
    },
    "%@ runs on this Mac at %@. Keep it open." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ runs on this Mac at %2$@. Keep it open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funciona en este Mac en %@. Mantenlo abierto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在这台 Mac 上运行于 %@。请保持打开。"
          }
        }
      }
    },
    "%@ sums up this chat and remembers only the recap and the last exchange. The whole chat stays to read. Use it when a chat grows too long; recap again as often as you like." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resume este chat y solo recuerda el resumen y el último intercambio. El chat completo sigue ahí para leerlo. Úsalo cuando un chat crezca demasiado; puedes resumir de nuevo tantas veces como quieras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会总结这段聊天，只记住总结和最后一轮对话。完整聊天仍可阅读。聊天过长时使用；可以随时再次总结。"
          }
        }
      }
    },
    "%@ uses %@'s model. Type another to give it its own." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ uses %2$@'s model. Type another to give it its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ usa el modelo de %2$@. Escribe otro para darle uno propio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 使用 %2$@ 的模型。输入其他模型可为它单独设置。"
          }
        }
      }
    },
    "%@'s animations" : {
      "localizations" : {
