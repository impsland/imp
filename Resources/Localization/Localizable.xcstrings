    "− leans left, + leans right. Double-click to straighten." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "− se inclina a la izquierda, + a la derecha. Doble clic para enderezarlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "− 向左倾，+ 向右倾。双击回正。"
          }
        }
      }
    },
    "− squishes flat, + stands tall and thin. Double-click to reset." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "− se aplasta, + se estira alto y delgado. Doble clic para restablecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "− 压扁，+ 拉高变瘦。双击重置。"
          }
        }
      }
    }
