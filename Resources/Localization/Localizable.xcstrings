    "“%@” must start with https://. Plain http:// works only for devices on your own network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” debe empezar por https://. http:// sin cifrar solo funciona con dispositivos de tu propia red."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 必须以 https:// 开头。普通 http:// 只适用于你自己网络中的设备。"
          }
        }
      }
    },
    "“%@” needs you to fill in: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” needs you to fill in: %2$@"
          }
