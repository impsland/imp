        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器拒绝了这台 Mac，所以你的 iPhone 无法从远处连到它。"
          }
        }
      }
    },
    "The tools it uses." : {
      "localizations" : {
