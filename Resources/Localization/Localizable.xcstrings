      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciando…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在启动…"
          }
        }
      }
    },
    "Startles and warns you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sobresalta y te avisa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吓了一跳并提醒你。"
          }
        }
      }
    },
    "Startles, winces, then looks away sheepishly." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sobresalta, hace una mueca y aparta la mirada avergonzado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吓了一跳，皱皱眉，然后不好意思地移开视线。"
          }
        }
      }
    },
    "Starts when an Imp that's out needs it" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inicia cuando un Imp que está fuera lo necesita"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在放出来的 Imp 需要时启动"
          }
        }
      }
    },
    "Starts when…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza cuando…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何时开始…"
          }
        }
      }
    },
    "Still not working after you allow it? Remove Imp from the list, add it again with +, then restart Imp." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sigue sin funcionar tras permitirlo? Quita Imp de la lista, vuelve a añadirlo con + y reinicia Imp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许后仍无法使用？从列表中移除 Imp，用 + 重新添加，然后重新启动 Imp。"
          }
        }
      }
    },
    "Stirring the cauldron…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removiendo el caldero…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在搅拌坩埚…"
          }
        }
      }
    },
    "Stop" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止"
          }
