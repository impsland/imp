          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 需要一个不超过 %lld 个字符的名字。"
          }
        }
      }
    },
    "An MCP server, on this Mac or on the web. Paste setup fills the form from a JSON config, command or address you copied from its page." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servidor MCP, en este Mac o en la web. Pegar configuración rellena el formulario con una configuración JSON, un comando o una dirección que copiaste de su página."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
