    "Imp %lld (“%@”)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Imp %1$lld (“%2$@”)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp %lld (“%@”)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp %lld（“%@”）"
          }
        }
      }
    },
    "Imp can't listen for your iPhone on this network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no puede escuchar a tu iPhone en esta red."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法在此网络上等待你的 iPhone 连接。"
          }
        }
      }
    },
    "Imp can't read that file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp no puede leer ese archivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imp 无法读取那个文件。"
          }
        }
      }
    },
    "Imp couldn't keep the account's key safe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
