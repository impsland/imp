    "The server turned this Mac away, so your iPhone can't reach it from afar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó este Mac, así que tu iPhone no puede llegar a él desde lejos."
          }
