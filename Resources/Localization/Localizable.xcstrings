          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何兼容 OpenAI 的 API，云端或本机均可。密钥只保存在这台 Mac 上。使用它的每个 Imp 都用它的模型，除非另选了自己的模型。"
          }
        }
      }
