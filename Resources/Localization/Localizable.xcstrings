          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把节拍一分为二"
          }
        }
      }
    },
    "Squeezes its eyes shut and wriggles with giggles." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra los ojos con fuerza y se retuerce de risa."
          }
