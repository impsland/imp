    },
    "Only %@ plays these. Make a new one, or its own version of a built-in one (it plays instead, for %@ alone). They go along when you share or export %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only %1$@ plays these. Make a new one, or its own version of a built-in one (it plays instead, for %2$@ alone). They go along when you share or export %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %1$@ reproduce estas. Crea una nueva, o su propia versión de una integrada (se reproduce en su lugar, solo para %2$@). Van incluidas cuando compartes o exportas a %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 %1$@ 会播放这些动画。可以新建一个，或制作它自己的内置动画版本（会代替内置动画播放，仅对 %2$@ 生效）。共享或导出 %3$@ 时它们会一起带走。"
          }
        }
      }
    },
