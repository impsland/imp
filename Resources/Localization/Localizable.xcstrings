          }
        }
      }
    },
    "Stopped before answering." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo antes de responder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在回答前已停止。"
          }
        }
      }
    },
    "Stops following you and stares you down." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de seguirte y te mira fijamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再跟着你，而是死死盯着你。"
          }
        }
      }
    },
    "Storyteller" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuentacuentos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讲故事的人"
          }
        }
      }
    },
    "Stretches tall and proud, sparkling from head to horn." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estira alto y orgulloso, brillando de la cabeza a los cuernos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "骄傲地挺直身子，从头到角都闪闪发光。"
          }
        }
      }
    },
    "Stretches tall, a big sleepy squeeze, then blinks awake." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estira bien alto, un gran apretón soñoliento, y luego parpadea despierto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使劲伸个大懒腰，然后眨眨眼醒了过来。"
          }
        }
      }
    },
    "Strikes a pose." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摆个造型。"
          }
        }
      }
    },
    "Stroke its head" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acariciarle la cabeza"
          }
        },
        "zh-Hans" : {
