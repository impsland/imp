        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昂首挺胸，闪闪发光。"
          }
        }
      }
    },
    "Stargaze" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirar las estrellas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观星"
          }
        }
      }
    },
    "Start a fresh chat. This one stays in the list below." : {
      "localizations" : {
        "es" : {
